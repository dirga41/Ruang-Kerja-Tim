# Untuk pengembangan lokal: salin file ini menjadi `.env`.
# Di Vercel: isi variabel yang sama di Project Settings → Environment Variables.

# --- Anthropic (key dari console.anthropic.com) ---
# Kosongkan semua API key untuk MODE DEMO (data simulasi, tanpa biaya).
ANTHROPIC_API_KEY=

# Model Claude untuk semua agent (opsional).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Penyedia lain yang kompatibel dengan OpenAI (OpenAI, OpenRouter, gateway pihak ketiga) ---
# Isi tiga variabel ini SEBAGAI GANTI ANTHROPIC_API_KEY. Model harus mendukung tool/function calling.
OPENAI_API_KEY=
# Base URL penyedia, tanpa /chat/completions di belakangnya.
OPENAI_BASE_URL=https://api.openai.com/v1
# ID model persis seperti tertulis di halaman daftar model penyedia.
OPENAI_MODEL=gpt-4o
# Batas token keluaran per giliran (opsional). Turunkan bila penyedia menolak, mis. 8192.
OPENAI_MAX_TOKENS=
# Bila kedua jenis key terisi, pilih di sini: anthropic atau openai.
LLM_PROVIDER=

# Kata sandi aplikasi (opsional, sangat disarankan bila API key diisi).
# Tanpa ini, siapa pun yang membuka URL aplikasi bisa memakai kuota API Anda.
APP_PASSWORD=

# Paksa mode demo walau API key terisi (true/false).
DEMO_MODE=false

# Kecepatan simulasi mode demo (dibaca saat build). 1 = normal, 2 = dua kali lebih cepat.
VITE_DEMO_SPEED=1

# --- Real-time (WebSocket) ---
# Kosong = pakai /ws di alamat yang sama (otomatis saat `npm run dev` dan `npm start`).
# Isi bila server real-time ada di alamat lain, mis. wss://ruang-kerja.up.railway.app/ws
# Isi `off` untuk mematikan WebSocket dan selalu memakai mode lokal di browser.
VITE_WS_URL=
# Batasi asal koneksi WebSocket (opsional, pisahkan dengan koma), mis. https://aplikasi-anda.vercel.app
WS_ALLOWED_ORIGINS=
# Port server produksi mandiri (`npm start`).
PORT=8787
